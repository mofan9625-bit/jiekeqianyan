<section class="kira-archives">
    <% 
        var pageHeading = '全站文章归档';
        if (is_category()) {
            pageHeading = '分类：' + page.category;
        } else if (is_tag()) {
            pageHeading = '标签：' + page.tag;
        } else if (page.year) {
            pageHeading = '归档：' + page.year + '年' + (page.month ? page.month + '月' : '');
        }
    %>
    <div class="kira-archive-header" style="margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px dashed rgba(0,0,0,0.1);">
        <h1 style="font-size: 1.5rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="kirafont <%= is_category() ? 'icon-container-fill' : (is_tag() ? 'icon-tag-fill' : 'icon-calendar-fill') %>"></i>
            <%= pageHeading %>
        </h1>
    </div>
    <div class="tagcloud kira-rainbow">
        <%- list_tags({
            show_count: true,
            style: "unordered list",
            class: "mdui-ripple ",
            separator: ""
        }) %>
    </div>
    <article>
        <% function buildArchive(posts, year) { %>
            <h2><%= year %></h2>
            <ul>
            <% posts.sort('date',-1).each(post => { %>
                <li><span><%= date(post.date, 'MM-DD') %></span><a href="<%- url_for(post.path) %>" ><%- post.title %></a></li>
            <% }) %>
            </ul>
        <% } %>
        <%
        if (!page.year) {
            let years = {};
            let allpost = page.tag ? site.tags.findOne({name: page.tag}).posts :  site.posts;
            allpost.each(post => years[post.date.year()] = null);
            for (let year of Object.keys(years).sort((a, b) => b - a)) {
                let posts = allpost.filter(p => p.date.year() == year);
                buildArchive(posts, year)
            }
        } else {
			let year = page.year;
			let posts = site.posts.filter(p => p.date.year() == year);
			buildArchive(posts, year)
        }
        %>
    </article>
</section>
<!DOCTYPE html>
<html <% if (config.language) { %>
	lang="<%- config.language %>"<% } %>>
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<%- css("css/layout") %>
		<% var title=page.title; if (is_archive()){ title=__('archive'); if
		(is_month()){ title +='：' + page.year + '/' + page.month; } else if (is_year()){ title
		+='：' + page.year; } } else if (is_category()){ title=__('count.categories') + '：' +
		page.category; } else if (is_tag()){ title=__('count.tags') + '：' + page.tag; } %>
		<title><% if (title){ %> <%= title %> - <% } %> <%= config.title %></title>
		
		<%
			var rawDesc = page.description || page.excerpt || page.content || config.description;
			var cleanDesc = strip_html(rawDesc || '').replace(/[\r\n\s]+/g, ' ').trim();
			if (cleanDesc.length > 150) {
				cleanDesc = cleanDesc.substring(0, 147) + '...';
			}
			var pageCanonicalUrl = config.url + url_for(page.path);
			if (pageCanonicalUrl.endsWith('index.html')) {
				pageCanonicalUrl = pageCanonicalUrl.slice(0, -10);
			}
		%>
		<!-- SEO & Meta Tags -->
		<meta name="description" content="<%= cleanDesc %>" />
		<meta name="keywords" content="<%= (page.tags && page.tags.length ? page.tags.map(t=>t.name).join(',') : config.keywords) %>" />
		<meta name="author" content="<%= config.author %>" />
		<link rel="canonical" href="<%= pageCanonicalUrl %>" />

		<!-- GEO & Region Metadata -->
		<meta name="geo.region" content="CN" />
		<meta name="geo.placename" content="China" />
		<meta name="geo.position" content="39.9042;116.4074" />
		<meta name="ICBM" content="39.9042, 116.4074" />

		<!-- Open Graph & Social Media Metadata -->
		<meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>" />
		<meta property="og:title" content="<%= title ? title + ' - ' + config.title : config.title %>" />
		<meta property="og:description" content="<%= cleanDesc %>" />
		<meta property="og:url" content="<%= pageCanonicalUrl %>" />
		<meta property="og:site_name" content="<%= config.title %>" />
		<meta property="og:image" content="<%= page.cover ? config.url + url_for(page.cover) : config.url + theme.avatar %>" />
		<meta property="og:locale" content="zh_CN" />

		<!-- Twitter Card Metadata -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="<%= title ? title + ' - ' + config.title : config.title %>" />
		<meta name="twitter:description" content="<%= cleanDesc %>" />
		<meta name="twitter:image" content="<%= page.cover ? config.url + url_for(page.cover) : config.url + theme.avatar %>" />

		<!-- Schema.org JSON-LD Structured Data -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "<%= is_post() ? 'BlogPosting' : 'WebSite' %>",
			"name": "<%= title ? title + ' - ' + config.title : config.title %>",
			"headline": "<%= title || config.title %>",
			"description": "<%- cleanDesc.replace(/"/g, '\\"') %>",
			"url": "<%= pageCanonicalUrl %>",
			"publisher": {
				"@type": "Organization",
				"name": "<%= config.title %>",
				"logo": {
					"@type": "ImageObject",
					"url": "<%= config.url + theme.avatar %>"
				}
			},
			"author": {
				"@type": "Person",
				"name": "<%= config.author %>"
			}<% if (is_post()) { %>,
			"datePublished": "<%= date(page.date, 'YYYY-MM-DDTHH:mm:ssZ') %>",
			"dateModified": "<%= date(page.updated || page.date, 'YYYY-MM-DDTHH:mm:ssZ') %>"
			<% } %>
		}
		</script>
		<!-- <link rel="stylesheet" href="https://unpkg.com/mdui@1.0.2/dist/css/mdui.min.css" /> -->
		<!-- <script src="https://unpkg.com/mdui@1.0.2/dist/js/mdui.min.js"></script> -->
		<%- css("lib/mdui/mdui.min") %>
		<%- js("lib/mdui/mdui.min") %>
		<!-- lazyload -->
		<%- js("lib/lazysizes") %>
		<!-- smooth-scrolling -->
		<%- js("lib/smooth-scrolling") %>
		<!-- highlight -->
		<%- css("lib/highlight/atom-one-dark.min") %>
		<%- js("lib/highlight/highlight.min") %>
		<!-- 预置 kiraicon -->
		<%- css("lib/iconfont/iconfont") %>
		<% if (theme.iconlib) { %>
			<link rel="stylesheet" href="<%= theme.iconlib %>" crossorigin />
		<% } %>
		<link
			rel="shortcut icon"
			href="<%= theme.favicon.href %>"
			type="<%= theme.favicon.type %>"
		/>
		<%- css("deps/css/APlayer.min") %>
		<% if (theme.customStyles) { %>
			<% theme.customStyles.forEach(function(customCss){ %>
				<%- css(customCss) %>
			<% }) %>
		<% } %>
		<%- js(["deps/js/APlayer.min", "deps/js/Meting.min", "js/avatar-fireworks"]) %>
	</head>

	<body>
		<div
			class="kira-background"
			style="background-image: url('<%= theme.background.path %>')"
		></div>
		<%- include("components/header") %>
		<div class="kira-body">
			<%- include("components/sidebar") %>
			<div class="kira-content">
				<div id="kira-top-header"></div>
				<div class="kira-main-content">
					<%- body %>
				</div>
			</div>
			<%- include("components/right-column") %>
		</div>
	</body>
</html>

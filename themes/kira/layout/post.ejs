<%- partial('components/kira-image') %>
<% if (theme.copyableCodeblock) { %>
	<%- css('css/kira-code-copy') %>
	<%- js('js/kira-code-copy') %>
<% } %>
<div class="kira-post">
	<article>
		<% if (page.cover){ %>
		<div class="kira-post-cover">
			<img
				data-src="<%- page.cover %>"
				data-sizes="auto"
				alt="<%= page.title %>"
				class="lazyload kira-post-cover-image disabled-kira-image"
			/>
			<h1><%= page.title %></h1>
		</div>
		<% } else { %>
		<div
			class="kira-post-cover"
			style="padding-bottom: '<%= theme.background.height/theme.background.width * 100 %>%'"
		>
			<img
				data-src="<%- theme.background.path %>"
				data-sizes="auto"
				alt="<%= page.title %>"
				class="lazyload kira-post-cover-image disabled-kira-image"
			/>
			<h1><%= page.title %></h1>
		</div>
		<% } %>
		<div class="kira-post-meta kira-rainbow" style="margin:10px 0!important;">
			<a><i class="kirafont icon-calendar-fill"></i><%- date(page.date, "YYYY年MM月DD日") %></a>
			<a><i class="kirafont icon-edit-fill"></i><%= wordcount(page.content) %> 字</a>
			<a><i class="kirafont icon-time-circle-fill"></i>大概 <%= min2read(page.content, {cn: 250, en: 160}) %> 分钟</a>
		</div>
		<%- image_auto_lazyload(page.content) %>
	</article>

	<% if (!page.reprinted){ %> <%- partial('components/copyright') %> <% } %> 
	<% if (page.layout == 'post') { %>
		<%
			// --- 1. 计算上一篇与下一篇（同分类优先，全站降级保底，彻底避免死胡同与重复） ---
			let prevPost = null;
			let nextPost = null;

			if (page.categories && page.categories.length) {
				const mainCat = page.categories.data ? page.categories.data[0] : page.categories[0];
				if (mainCat && mainCat.posts) {
					const catPosts = mainCat.posts.sort('date', 1).toArray();
					if (catPosts.length > 1) {
						const curIdx = catPosts.findIndex(function(p) { return p._id === page._id || p.path === page.path; });
						if (curIdx !== -1) {
							if (curIdx > 0) prevPost = catPosts[curIdx - 1];
							if (curIdx < catPosts.length - 1) nextPost = catPosts[curIdx + 1];
						}
					}
				}
			}

			// 安全保底：当分类单侧无文章时，取全站时间线补全，但严格校验互斥避免重复
			if (!prevPost && page.prev && (!nextPost || page.prev.path !== nextPost.path)) {
				prevPost = page.prev;
			}
			if (!nextPost && page.next && (!prevPost || page.next.path !== prevPost.path)) {
				nextPost = page.next;
			}

			if (prevPost && nextPost && prevPost.path === nextPost.path) {
				prevPost = null;
			}

			// --- 2. 计算智能相关推荐文章（基于 Tags 相似度权重与 Category） ---
			let relatedPosts = [];
			const currentTagNames = [];
			if (page.tags && page.tags.length) {
				page.tags.forEach(function(t) {
					currentTagNames.push(t.name || t);
				});
			}

			const scoredPosts = [];
			site.posts.forEach(function(p) {
				if (p.path === page.path) return;
				let score = 0;
				if (p.tags && p.tags.length && currentTagNames.length) {
					p.tags.forEach(function(t) {
						const tName = t.name || t;
						if (currentTagNames.indexOf(tName) !== -1) {
							score += 2;
						}
					});
				}
				if (page.categories && page.categories.length && p.categories && p.categories.length) {
					const curCatName = page.categories.data ? page.categories.data[0].name : page.categories[0].name;
					const pCatName = p.categories.data ? p.categories.data[0].name : p.categories[0].name;
					if (curCatName && pCatName && curCatName === pCatName) {
						score += 1;
					}
				}
				if (score > 0) {
					scoredPosts.push({ post: p, score: score });
				}
			});

			scoredPosts.sort(function(a, b) {
				return b.score - a.score || b.post.date - a.post.date;
			});

			relatedPosts = scoredPosts.slice(0, 3).map(function(item) { return item.post; });

			if (relatedPosts.length < 3) {
				const usedPaths = [page.path];
				relatedPosts.forEach(function(p) { usedPaths.push(p.path); });
				site.posts.sort('date', -1).forEach(function(p) {
					if (relatedPosts.length >= 3) return;
					if (usedPaths.indexOf(p.path) === -1) {
						relatedPosts.push(p);
						usedPaths.push(p.path);
					}
				});
			}
		%>

		<!-- 延伸阅读 / 推荐专题（纯净极客卡片，无大图干扰） -->
		<% if (relatedPosts.length > 0) { %>
		<div class="kira-related-posts">
			<div class="kira-related-title">
				<i class="kirafont icon-unordered-list"></i> 延伸阅读 / 推荐专题
			</div>
			<div class="kira-related-list">
				<% relatedPosts.forEach(function(rp) { %>
				<a href="<%- url_for(rp.path) %>" class="kira-related-card">
					<div class="kira-related-header">
						<% if (rp.categories && rp.categories.length) { %>
						<span class="kira-related-badge">
							<i class="kirafont icon-container-fill"></i>
							<%= rp.categories.data ? rp.categories.data[0].name : rp.categories[0].name %>
						</span>
						<% } else { %>
						<span class="kira-related-badge">推荐</span>
						<% } %>
						<span class="kira-related-time">
							<i class="kirafont icon-time-circle-fill"></i>
							<%= min2read(rp.content, {cn: 250, en: 160}) %> 分钟
						</span>
					</div>
					<div class="kira-related-card-title"><%= rp.title %></div>
					<% 
						let desc = rp.description || strip_html(rp.content).substring(0, 75).trim() + '...';
					%>
					<div class="kira-related-desc"><%= desc %></div>
					<div class="kira-related-footer">
						<span class="kira-related-date"><i class="kirafont icon-calendar-fill"></i> <%- date(rp.date, "YYYY-MM-DD") %></span>
						<span class="kira-related-more">阅读全文 <i class="kirafont icon-right"></i></span>
					</div>
				</a>
				<% }); %>
			</div>
		</div>
		<% } %>

		<!-- 上一篇 / 下一篇 导航卡片 -->
		<div class="kira-post-nav">
			<nav class="post-nav">
				<% if (prevPost) { %>
				<div class="old">
					<a href="<%- url_for(prevPost.path) %>" class="nav-card" title="<%= prevPost.title %>">
						<span class="nav-direction"><i class="kirafont icon-left"></i> 上一篇</span>
						<span class="nav-title"><%= prevPost.title %></span>
					</a>
				</div>
				<% } else { %>
				<div class="old empty"></div>
				<% } %>

				<% if (nextPost) { %>
				<div class="new">
					<a href="<%- url_for(nextPost.path) %>" class="nav-card" title="<%= nextPost.title %>">
						<span class="nav-direction">下一篇 <i class="kirafont icon-right"></i></span>
						<span class="nav-title"><%= nextPost.title %></span>
					</a>
				</div>
				<% } else { %>
				<div class="new empty"></div>
				<% } %>
			</nav>
		</div>
	<% } %>
	<div class="kira-post-meta kira-rainbow">
		<% if (page.categories && page.categories.length){ %>
			<%- list_categories(page.categories, {
				show_count: false,
				class: 'kirafont icon-container-fill ',
				style: 'none',
				separator: ''
			}) %>
		<% } %>
		<% if (page.tags && page.tags.length){ %>
			<%- list_tags(page.tags, {
				show_count: false,
				class: 'kirafont icon-tag-fill ',
				style: 'none',
				separator: ' '
			}) %>
		<% } %>
	</div>
	<% if (page.comments){ %>
	<div class="kira-post-footer">
		<%- partial('components/comments/gitalk') %>
		<%- partial('components/comments/giscus') %>
	</div>
	<% } %>
</div>
